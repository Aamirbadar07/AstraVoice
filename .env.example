# Google Cloud OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Host Google Calendar details
HOST_CALENDAR_ID=primary
HOST_EMAIL=your_email@gmail.com

# Server configuration
FRONTEND_URL=http://localhost:8000
SECRET_KEY=any_random_secret_string

# Host IANA timezone, used for all date math (e.g. Asia/Kolkata, America/New_York)
HOST_TIMEZONE=Asia/Kolkata

# Optional shared secret for the API bridge. If set, also set BRIDGE_TOKEN in index.html.
BRIDGE_TOKEN=

# Gemini API key - stays server-side. The browser gets short-lived tokens only.
GEMINI_API_KEY=

# Meeting + working-hours defaults
MEETING_MINUTES=30
WORK_START_HOUR=9
WORK_END_HOUR=18
