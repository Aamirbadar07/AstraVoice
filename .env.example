# Google Cloud OAuth 2.0 Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Host Google Calendar details
HOST_CALENDAR_ID=primary
HOST_EMAIL=your_email@gmail.com

# Server configuration
PORT=5000
FRONTEND_URL=http://localhost:8000
SECRET_KEY=any_random_secret_string

# Optional CORS configuration (comma-separated origins, or * for open dev)
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Host IANA timezone, used for all date math (e.g. Asia/Kolkata, America/New_York)
HOST_TIMEZONE=Asia/Kolkata

# Optional shared secret for the API bridge. If set, also set BRIDGE_TOKEN in index.html.
BRIDGE_TOKEN=

# Gemini API key(s) - stays server-side. The browser gets short-lived tokens only.
# Supply a single key OR a comma-separated list of keys for automatic rotation & rate-limit failover:
GEMINI_API_KEY=
# GEMINI_API_KEYS=key_1,key_2,key_3

# For Cloud Run / container deployment (raw stringified JSON of token.json):
# GOOGLE_TOKEN_JSON=

# Meeting + working-hours defaults
MEETING_MINUTES=30
WORK_START_HOUR=9
WORK_END_HOUR=18

# Security & verification rules
# Enforce that proposed meetings cannot be in the past (default: false for test back-compat, true recommended for prod)
ENFORCE_FUTURE_DATES=false
PROPOSAL_TTL_SECONDS=300
